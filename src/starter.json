              "620",
              "652",
              "642"
            ]
          ]
        }
      }
    },
    "ds_services": {
      "type": "ds.test",
      "options": {
        "data": {
          "fields": [
            {
              "name": "service"
            },
            {
              "name": "p95_ms"
            },
            {
              "name": "failure_percent"
            }
          ],
          "columns": [
            [
              "checkout",
              "payments",
              "inventory"
            ],
            [
              "642",
