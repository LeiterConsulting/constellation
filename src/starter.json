            ]
          ]
        }
      }
    },
    "ds_ranked": {
      "type": "ds.test",
      "options": {
        "data": {
          "fields": [
            {
              "name": "service"
            },
            {
              "name": "p95_ms"
            }
          ],
          "columns": [
            [
              "checkout",
              "payments",
              "inventory"
            ],
            [
              "642",
              "418",
              "186"
            ]
          ]
        }
      }
    }
  },
  "inputs": {
    "input_time": {
      "type": "input.timerange",
      "title": "Time range \u00b7 static example",
      "options": {
        "token": "global_time",
        "defaultValue": "-24h@h,now"
      }
    }
  },
  "defaults": {
    "tokens": {
      "default": {
        "selected_service": {
          "value": "checkout"
        }
      }
    }
  },
  "layout": {
    "globalInputs": [
      "input_time"
    ],
    "tabs": {
      "items": [
        {
          "label": "Overview",
          "layoutId": "layout_overview"
        },
        {
          "label": "Service detail",
          "layoutId": "layout_detail"
        }
      ]
    },
    "layoutDefinitions": {
      "layout_overview": {
        "type": "absolute",
        "options": {
          "width": 1200,
          "height": 740,
          "display": "auto-scale"
        },
        "structure": [
          {
            "item": "viz_requests",
            "type": "block",
            "position": {
              "x": 0,
              "y": 0,
              "w": 390,
              "h": 110
            }
          },
          {
