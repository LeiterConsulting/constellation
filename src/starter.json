{
  "title": "Checkout performance",
  "description": "Latency, failures, and the services that need attention. Authored sample data.",
  "visualizations": {
    "viz_requests": {
      "type": "splunk.singlevalue",
      "title": "Requests",
      "options": {
        "backgroundColor": "transparent"
      },
      "dataSources": {
        "primary": "ds_requests"
      }
    },
    "viz_latency": {
      "type": "splunk.singlevalue",
      "title": "p95 latency (ms)",
      "options": {
        "backgroundColor": "transparent"
      },
      "dataSources": {
        "primary": "ds_p95"
      }
    },
    "viz_failures": {
      "type": "splunk.singlevalue",
      "title": "Failure rate (%)",
      "options": {
        "numberPrecision": 2,
        "backgroundColor": "transparent"
      },
      "dataSources": {
        "primary": "ds_failures"
      }
    },
    "viz_trend": {
      "type": "splunk.line",
      "title": "How latency changed \u00b7 sample day",
      "options": {
        "yAxisTitleText": "p95 latency (ms)",
        "legendDisplay": "bottom",
        "backgroundColor": "transparent"
      },
      "dataSources": {
        "primary": "ds_latency"
      }
    },
    "viz_services": {
      "type": "splunk.table",
      "title": "Services \u00b7 select a service to open its detail",
      "options": {
        "backgroundColor": "transparent"
      },
      "dataSources": {
        "primary": "ds_services"
      },
      "eventHandlers": [
        {
          "type": "drilldown.setToken",
          "options": {
            "tokens": [
              {
                "token": "selected_service",
                "key": "row.service.value"
              }
            ],
            "fields": [
              "service"
            ]
          }
        },
        {
          "type": "drilldown.switchToTab",
          "options": {
            "tabId": "layout_detail",
            "fields": [
              "service"
            ]
          }
        }
      ]
    },
    "viz_ranked": {
      "type": "splunk.bar",
      "title": "Latency by service (ms)",
      "options": {
        "backgroundColor": "transparent"
      },
      "dataSources": {
        "primary": "ds_ranked"
      }
    },
    "viz_detail": {
      "type": "splunk.markdown",
      "options": {
        "markdown": "## Service detail\n\nSelected service: **$selected_service$**\n\nThis is authored sample data. The row interaction preserves the selected service token when switching tabs.",
        "backgroundColor": "transparent"
      }
    }
  },
  "dataSources": {
    "ds_requests": {
      "type": "ds.test",
      "options": {
        "data": {
          "fields": [
            {
              "name": "requests"
            }
          ],
          "columns": [
            [
              "2400000"
            ]
          ]
        }
      }
    },
    "ds_p95": {
      "type": "ds.test",
      "options": {
        "data": {
          "fields": [
            {
              "name": "p95_ms"
            }
          ],
          "columns": [
            [
              "642"
            ]
          ]
        }
      }
    },
    "ds_failures": {
      "type": "ds.test",
      "options": {
        "data": {
          "fields": [
            {
              "name": "failure_percent"
            }
          ],
          "columns": [
            [
              "1.49"
            ]
          ]
        }
      }
    },
    "ds_latency": {
      "type": "ds.test",
      "options": {
        "data": {
          "fields": [
            {
              "name": "_time"
            },
            {
              "name": "p95_ms"
            }
          ],
          "columns": [
